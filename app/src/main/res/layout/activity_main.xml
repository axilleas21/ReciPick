                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Baking Powder" />

            <CheckBox
                android:id="@+id/cbBanana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banana" />

            <CheckBox
                android:id="@+id/cbBread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bread" />

            <CheckBox
                android:id="@+id/cbButter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
